generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String @id @default(cuid())
  login        String @unique
  passwordHash String
  salt         String
  posts        Post[]
}

enum UserRole {
  SuperAdmin
  Admin
  Contributor
  Simple
}

model Post {
  id          String     @id @default(cuid())
  title       String
  content     String
  status      PostStatus
  user        User       @relation(fields: [post_author], references: [id])
  post_author String
}

enum PostStatus {
  New
  Archive
  Published
}
